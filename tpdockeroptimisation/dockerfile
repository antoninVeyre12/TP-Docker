FROM node:latest

WORKDIR /app

COPY package*.json ./

RUN npm install

COPY . /app

RUN apt-get update && apt-get install -y build-essential ca-certificates locales && echo "en_US.UTF-8 UTF-8" > /etc/locale.gen && locale-gen

EXPOSE 3000

ENV NODE_ENV=development

RUN npm run build

USER node

CMD ["node", "server.js"]